<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IoT Environmental Monitoring</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: radial-gradient(circle at top, #0b1220, #050814);
            color: #e2e8f0;
            min-height: 100vh;
            padding: 2rem;
        }

        header {
            text-align: center;
            margin-bottom: 2rem;
        }

        header h1 {
            font-size: 2rem;
            color: #38bdf8;
            letter-spacing: 0.5px;
        }

        header p {
            color: #94a3b8;
            margin-top: 0.4rem;
            font-size: 0.95rem;
        }

        .status {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            margin-top: 0.8rem;
            font-size: 0.85rem;
            color: #94a3b8;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #64748b;
            transition: all 0.3s ease;
        }

        .dot.on {
            background: #22c55e;
            box-shadow: 0 0 10px #22c55e;
            animation: pulse 2s infinite;
        }

        .dot.err {
            background: #ef4444;
            box-shadow: 0 0 10px #ef4444;
        }

        @keyframes pulse {

            0%,
            100% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.3);
                opacity: 0.5;
            }
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem;
            max-width: 900px;
            margin: 0 auto 2rem;
        }

        .card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(10px);
            border-radius: 18px;
            padding: 1.8rem;
            text-align: center;
            border: 1px solid rgba(51, 65, 85, 0.6);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
        }

        .card .icon {
            font-size: 2.8rem;
            margin-bottom: 0.5rem;
        }

        .card .label {
            font-size: 0.75rem;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        .card .value {
            font-size: 2.6rem;
            font-weight: 700;
            margin: 0.4rem 0;
            line-height: 1;
        }

        .card .unit {
            font-size: 0.85rem;
            color: #64748b;
        }

        .card.temp .value {
            color: #f97316;
        }

        .card.humid .value {
            color: #38bdf8;
        }

        .card.light .value {
            color: #facc15;
        }

        .history {
            max-width: 900px;
            margin: 0 auto;
        }

        .history h2 {
            font-size: 1rem;
            color: #94a3b8;
            margin-bottom: 1rem;
            border-left: 3px solid #38bdf8;
            padding-left: 0.75rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.875rem;
            overflow: hidden;
            border-radius: 12px;
        }

        th {
            text-align: left;
            padding: 0.8rem 1rem;
            color: #64748b;
            font-weight: 500;
            border-bottom: 1px solid #1e293b;
        }

        td {
            padding: 0.8rem 1rem;
            border-bottom: 1px solid #1e293b;
            color: #cbd5e1;
        }

        tr:hover td {
            background: rgba(30, 41, 59, 0.6);
        }

        .badge {
            display: inline-block;
            padding: 0.25rem 0.65rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-temp {
            background: rgba(251, 146, 60, 0.15);
            color: #fb923c;
        }

        .badge-humid {
            background: rgba(56, 189, 248, 0.15);
            color: #38bdf8;
        }

        .badge-lux {
            background: rgba(250, 204, 21, 0.15);
            color: #facc15;
        }

        #status-conn {
            font-size: 0.8rem;
            color: #94a3b8;
        }

        footer {
            text-align: center;
            margin-top: 3rem;
            color: #475569;
            font-size: 0.8rem;
        }
    </style>
</head>

<body>

    <header>
        <h1>🌡 IoT Environmental Monitoring</h1>
        <p>ESP32 + DHT22 via Wokwi Private Gateway</p>

        <div class="status">
            <span class="dot" id="dot-conn"></span>
            <span id="status-conn">connecting to ESP32...</span>
        </div>
    </header>

    <div class="cards">
        <div class="card temp">
            <div class="icon">🌡</div>
            <div class="label">Temperature</div>
            <div class="value" id="val-temp">--</div>
            <div class="unit">°C</div>
        </div>

        <div class="card humid">
            <div class="icon">💧</div>
            <div class="label">Humidity</div>
            <div class="value" id="val-umid">--</div>
            <div class="unit">%</div>
        </div>

        <div class="card light">
            <div class="icon">🔆</div>
            <div class="label">Luminosity</div>
            <div class="value" id="val-lux">--</div>
            <div class="unit">/ 4095</div>
        </div>
    </div>

    <div class="history">
        <h2>Readings History</h2>

        <table>
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Temperature</th>
                    <th>Humidity</th>
                    <th>Luminosity</th>
                </tr>
            </thead>

            <tbody id="tabela-historico">
                <tr>
                    <td colspan="4" style="color:#475569; text-align:center; padding:2rem">
                        Waiting for ESP32 data...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <footer>
        IoT Monitoring · ESP32
    </footer>

    <script>
        const ESP32_URL = '{{ esp32_url_monitoring }}';
        const historico = [];

        function horario() {
            return new Date().toLocaleTimeString('pt-BR');
        }

        function atualizarTabela() {
            const tbody = document.getElementById('tabela-historico');
            if (historico.length === 0) return;

            tbody.innerHTML = historico.slice().reverse().map((l) => `
                <tr>
                    <td>${l.hora}</td>
                    <td><span class="badge badge-temp">${l.temperatura} °C</span></td>
                    <td><span class="badge badge-humid">${l.umidade} %</span></td>
                    <td><span class="badge badge-lux">${l.luminosidade}</span></td>
                </tr>
            `).join('');
        }

        function buscarDados() {
            fetch(ESP32_URL)
                .then(r => {
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.json();
                })
                .then(d => {
                    document.getElementById('val-temp').textContent = parseFloat(d.temperatura).toFixed(1);
                    document.getElementById('val-umid').textContent = parseFloat(d.umidade).toFixed(1);
                    document.getElementById('val-lux').textContent = parseInt(d.luminosidade) || '--';

                    document.getElementById('dot-conn').className = 'dot on';
                    document.getElementById('status-conn').textContent =
                        'connected · last update: ' + horario();

                    historico.push({
                        hora: horario(),
                        temperatura: parseFloat(d.temperatura).toFixed(1),
                        umidade: parseFloat(d.umidade).toFixed(1),
                        luminosidade: parseInt(d.luminosidade) || 0
                    });

                    if (historico.length > 50) historico.shift();

                    atualizarTabela();
                })
                .catch(err => {
                    document.getElementById('dot-conn').className = 'dot err';
                    document.getElementById('status-conn').textContent =
                        'connection failed (' + err.message + ')';
                });
        }

        buscarDados();
        setInterval(buscarDados, 5000);
    </script>

</body>

</html>